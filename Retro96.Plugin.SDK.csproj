<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- The public contract is compiled into the host under this exact assembly name. -->
    <AssemblyName>Retro96</AssemblyName>
    <RootNamespace>Retro96.Plugins</RootNamespace>

    <Version>$(Retro96PluginSdkVersion)</Version>
    <PackageVersion>$(Retro96PluginSdkVersion)</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <PackageId>Retro96.Plugin.SDK</PackageId>
    <Authors>Retro96</Authors>
    <Description>Public C# API and manifest contracts for Retro96 .r96p plugins.</Description>
    <PackageTags>Retro96;browser;plugin;sdk;.r96p</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- SDK artifacts stay under the repository's generated folder. -->
    <BaseOutputPath>$(MSBuildProjectDirectory)\artifacts\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\artifacts\obj\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildProjectDirectory)\artifacts\packages</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Examples and tooling are repository content, not part of the SDK contract assembly. -->
    <Compile Remove="examples\**;artifacts\**;scripts\**" />
    <None Remove="examples\**;artifacts\**;scripts\**" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
