<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Retro96.SamplePlugin</AssemblyName>
    <RootNamespace>Retro96.SamplePlugin</RootNamespace>
    <BaseOutputPath>$(MSBuildProjectDirectory)\dist\build\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\dist\obj\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the 1.0.0 contract; the host supplies Retro96.dll at runtime. -->
    <ProjectReference Include="..\..\Retro96.Plugin.SDK.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
